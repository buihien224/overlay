    <!-- Guide / tutorial -->
    <string name="guide_on_off_screen_comment">Để duy trì trải nghiệm chơi game tốt, khi chơi một số trò chơi trên màn hình trước, màn hình phụ không thể được đánh thức bằng cách chạm đúp</string>
    <string name="guide_on_off_screen_summary">Chạm đúp để thức màn hình phụ, rồi chạm đúp lại để tắt.</string>
    <string name="guide_on_off_screen_title">Bật và tắt màn hình</string>
    <string name="guide_set_wallpaper_title">Hình nền cá nhân hóa</string>
    <string name="guide_use_pin_summary">Dùng Xiaomi Hyper XiaoAi để khoanh tròn thông tin quan trọng trên màn hình trước, rồi ghim lên màn hình phụ để tham khảo dễ dàng. Cũng hoạt động với ảnh từ Thư viện.</string>
    <string name="guide_use_pin_title">Tin nhắn đã ghim</string>

