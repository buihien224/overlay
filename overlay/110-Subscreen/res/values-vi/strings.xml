    <string name="ms_guide_tip_assistant">Vuốt xuống từ trên cùng để mở Trợ lý. Vuốt theo chiều dọc để chuyển đổi dịch vụ. Vuốt lên từ phía dưới để đóng.</string>
    <string name="ms_guide_tip_assistant_new">Vuốt xuống từ trên cùng để mở dịch vụ, vuốt lên hoặc xuống để chuyển đổi giữa chúng, và vuốt lên từ phía dưới để đóng.</string>
    <string name="ms_guide_tip_camera">Vuốt sang phải để mở camera. Vuốt từ cạnh sang trái để quay lại.</string>
    <string name="ms_guide_tip_dial">Nhấn giữ để chỉnh sửa. Vuốt ngang để chuyển đổi đồng hồ. Nhấn để xác nhận.</string>
    <string name="ms_guide_tip_wallpaper">Nhấn giữ để chỉnh sửa, vuốt trái hoặc phải để đổi hình nền, nhấn để xác nhận.</string>
