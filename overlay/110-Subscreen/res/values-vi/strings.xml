    <!-- Rear display notification settings (sub_screen_*) -->
    <string name="sub_screen_detail_disable_comment">Để hiển thị chi tiết thông báo, hãy đảm bảo:\n%1$d. Thông báo màn hình khóa được đặt thành \"Hiện thông báo và nội dung\".\n%2$d. \"Hiện chi tiết thông báo sau khi xác minh khuôn mặt\" bị tắt cho Mở khóa khuôn mặt.</string>
    <string name="sub_screen_notification_detail_summary">Chi tiết thông báo sẽ được hiển thị trên màn hình phụ. Hãy lưu ý đến quyền riêng tư của bạn.</string>
    <string name="sub_screen_notification_detail_title">Hiện chi tiết thông báo</string>
    <string name="sub_screen_notification_disable_comment">Để nhận thông báo trên màn hình phụ, hãy đảm bảo thông báo màn hình khóa được đặt thành \"Không hiện thông báo màn hình khóa\"</string>
